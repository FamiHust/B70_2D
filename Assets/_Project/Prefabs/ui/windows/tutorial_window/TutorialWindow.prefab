  TutorialSteps:
  - text: Hi! Welcome to B70 - A beautiful island!
    characterSprite: {fileID: 21300000, guid: 4b59c03a57461dc458da74f0e355db19, type: 3}
  - text: My name is Giang, and I'll be your guide.
    characterSprite: {fileID: 21300000, guid: 829ce076cb87c30419e16865bffff283, type: 3}
  - text: Our mission is to recreate Hanoi University of Science and Technology.
    characterSprite: {fileID: 21300000, guid: 6b889fc05a10c1741a361fa9e3466537, type: 3}
  - text: Now! Let's start building the first structure!
    characterSprite: {fileID: 21300000, guid: 906e1beca630e574babc9af98912997e, type: 3}
