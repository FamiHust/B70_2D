  eventID: "B\u1ECB tr\u1ED9m m\u1EA5t m\u0169 b\u1EA3o hi\u1EC3m "
  eventName: "B\u1ECB tr\u1ED9m m\u1EA5t m\u0169 b\u1EA3o hi\u1EC3m "
  description: "M\u1ED9t \xF4ng ch\xFA \u0111eo kh\u1EA9u trang m\u1EB7c \xE1o HUST
    v\u1EEBa \"nh\u1EA5c\" nh\u1EB9 chi\u1EBFc m\u0169 c\u1EE7a m\u1ED9t nam sinh
    t\u1EA1i b\xE3i xe"
