    happinessModifier: 2
    educationModifier: 0
  - title: "Nh\u1EAFc nh\u1EDF chung"
    description: "Vi\u1EBFt b\xE0i tr\xEAn confession tr\u01B0\u1EDDng nh\u1EAFc
