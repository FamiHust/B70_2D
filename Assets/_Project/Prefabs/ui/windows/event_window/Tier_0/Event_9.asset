  triggerProbability: 0.3
  options:
  - title: "H\u1ED7 tr\u1EE3 kh\u1EA9n c\u1EA5p"
    description: "Tr\xEDch qu\u1EF9 nh\u1ECF h\u1ED7 tr\u1EE3 sinh vi\xEAn chi ph\xED
      l\xE0m l\u1EA1i gi\u1EA5y t\u1EDD v\xE0 ti\u1EC1n sinh ho\u1EA1t t\u1EA1m th\u1EDDi."
    goldModifier: -18
    happinessModifier: 2
    educationModifier: 2
  - title: "B\xE1o c\xF4ng an"
    description: "Chi ti\u1EC1n b\u1ED3i d\u01B0\u1EE1ng \u0111\u1ED9i b\u1EA3o v\u1EC7
